# Gray Art environment reference
#
# Copy this file to your local environment file and fill real values locally.
# Never commit real provider credentials, API keys, OAuth secrets, JWT secrets,
# WhatsApp keys, database files, or production tokens.
#
# Security model:
# - Browser-readable VITE_* variables must not contain secrets.
# - OAuth client secrets and API keys belong on the backend only.
# - The frontend should call the BFF/API, and the BFF should call providers.

# Public frontend config
VITE_BACKEND_URL=http://localhost:8080

# Backend service
PORT=3060
APP_BASE_URL=http://localhost:3060
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:./server/database.sqlite
JWT_SECRET=replace-with-a-long-random-secret

# Seed data
# Required when running the database seed. Do not use a weak shared password.
SEED_ADMIN_EMAIL=admin@grayart.local
SEED_ADMIN_PASSWORD=replace-with-a-local-password-at-least-12-chars

# AI providers - backend only
GEMINI_API_KEY=replace-with-local-gemini-key

# WhatsApp / Evolution API - backend only
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace-with-local-evolution-key

# Flow backend - backend only
FLOW_API_URL=http://localhost:8080
FLOW_USER=replace-with-local-flow-user
FLOW_PASS=replace-with-local-flow-password

# Social OAuth - backend only
META_APP_ID=replace-with-local-meta-app-id
META_APP_SECRET=replace-with-local-meta-app-secret
LINKEDIN_CLIENT_ID=replace-with-local-linkedin-client-id
LINKEDIN_CLIENT_SECRET=replace-with-local-linkedin-client-secret
TIKTOK_CLIENT_KEY=replace-with-local-tiktok-client-key
TIKTOK_CLIENT_SECRET=replace-with-local-tiktok-client-secret
GOOGLE_CLIENT_ID=replace-with-local-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-local-google-client-secret
PINTEREST_APP_ID=replace-with-local-pinterest-app-id
PINTEREST_APP_SECRET=replace-with-local-pinterest-app-secret
